# ==============================================================================
# WORKSPACE Environment Configuration
# Copy this file to .env and configure the values for your environment.
# Never commit .env with real secrets to version control.
# ==============================================================================

# Application & Server Configuration
APP_ENV=development                       # development | production | test
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
APP_URL=http://localhost:3000

# Desktop / Local Storage
WORKSPACE_DATA_DIR=~/.workspace
SQLITE_DB_PATH=~/.workspace/workspace.sqlite

# Cloud Multi-tenant Database (PostgreSQL + pgvector)
# Required when running workspace-server in cloud mode
DATABASE_URL=postgres://workspace_user:workspace_pass@localhost:5432/workspace_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Authentication & Security
# Generate a secure 64-char random string: openssl rand -hex 32
JWT_SECRET=change-this-in-production-to-a-secure-random-64-character-string
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
PASSWORD_SALT_ROUNDS=12

# Focus & Activity Tracking
IDLE_THRESHOLD_MINUTES=5
AUTOSAVE_INTERVAL_SECONDS=60

# AI Provider Configuration (Model-Agnostic)
# Default provider options: gemini | openai | anthropic | ollama
DEFAULT_AI_PROVIDER=gemini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Local Ollama (Offline / Private AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/integrations/github/callback

# Notifications & Reminders
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WORKSPACE <no-reply@workspace.dev>

# WhatsApp Business API (Optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
